# Panel faqat backend bilan ishlaydi — namuna (mock) rejimi yo'q.

# Qaysi server bilan ishlaymiz — nomlar va default `config/servers.mjs` da:
# prod — https://my.imorganic.uz (default), test — https://imorganic.uz.
# Vaqtincha almashtirish uchun (faylga tegmasdan): APP_SERVER=test npm run dev
# APP_SERVER=test

# Nomlanganlardan boshqa manzil (lokal yoki vaqtinchalik). Berilsa APP_SERVER dan ustun.
# Faqat origin, yo'lsiz.
# BACKEND_ORIGIN=http://127.0.0.1:8000

# Jonli hodisalar uchun WebSocket manzili (ixtiyoriy; bo'lmasa lenta so'rov bilan yangilanadi).
# Bu alohida sozlanadi — APP_SERVER ga bog'lanmagan (brauzer o'zi ulanadi).
# NEXT_PUBLIC_WS_URL=wss://my.imorganic.uz/ws/owner/

# --- Telegram mini app (../doctor_ali_owner_bot/docs/03_SETUP.md) ---
# Bot username (@ siz) — sahifa Telegramdan tashqarida ochilsa «Botni ochish» havolasi uchun.
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=doctor_ali_nazorat_bot

# Faqat `npm run dev`: Telegramda sinash uchun HTTPS tunnel domeni (vergul bilan).
# DEV_ALLOWED_ORIGINS=*.trycloudflare.com
