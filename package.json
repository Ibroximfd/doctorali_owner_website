    "samples": "vite-node --config vitest.config.ts scripts/dump-api-samples.ts",
    "contract:check": "vite-node --config vitest.config.ts scripts/check-backend-contract.ts --",
    "backend:login": "vite-node --config vitest.config.ts scripts/backend-login.ts"
  },
