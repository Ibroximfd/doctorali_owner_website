# Mock rejimi: 1 — backendsiz, namuna ma'lumot bilan ishlaydi (istalgan login/parol, istalgan 6 xonali kod).
NEXT_PUBLIC_API_MOCKING=1

# Qaysi server (mock o'chirilganda) — `config/servers.mjs`: prod (default) yoki test.
# Vaqtincha: APP_SERVER=test npm run dev
# APP_SERVER=test

# Nomlanganlardan boshqa manzil kerak bo'lsa (lokal backend). Ustun turadi; faqat origin, yo'lsiz.
# BACKEND_ORIGIN=http://127.0.0.1:8000

# Jonli hodisalar uchun WebSocket manzili (ixtiyoriy; bo'lmasa lenta so'rov bilan yangilanadi).
# NEXT_PUBLIC_WS_URL=wss://my.imorganic.uz/ws/owner/
